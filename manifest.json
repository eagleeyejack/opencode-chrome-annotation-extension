{
  "manifest_version": 3,
  "name": "OpenCode Annotate",
  "short_name": "OpenCode Annotate",
  "version": "1.4.0",
  "description": "Annotate any webpage and send screenshots, element selectors, and instructions to your OpenCode agent.",
  "homepage_url": "https://github.com/eagleeyejack/opencode-chrome-annotation-extension",
  "minimum_chrome_version": "114",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected/dom.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "OpenCode Annotate",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
